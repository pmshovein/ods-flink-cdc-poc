# Deployment identity
ODS_ENVIRONMENT=dev
ODS_AWS_ACCOUNT=111111111111
ODS_AWS_REGION=us-east-1

# Pre-built MSF artifact and service role
ODS_ARTIFACT_BUCKET=replace-with-artifact-bucket
ODS_ARTIFACT_KEY=artifacts/ods-flink-cdc.zip
ODS_MSF_EXECUTION_ROLE_ARN=arn:aws:iam::111111111111:role/ods-msf-execution

# Runtime configuration passed to the job by MSF
ODS_MSK_BOOTSTRAP_SERVERS=b-1.example:9098,b-2.example:9098
ODS_CDC_TOPIC_PATTERN=claims\\.public\\..*
ODS_DLQ_TOPIC=ods.cdc.dlq
ODS_GLUE_DATABASE=ods
ODS_ICEBERG_WAREHOUSE=s3://replace-with-warehouse/iceberg
ODS_CHECKPOINT_INTERVAL_MS=60000

